alunos={}
lista_alunos=[]
qntd_alunos=int(input("Digite a quantidade de alunos: "))
x=0
for i in range(qntd_alunos):
    x +=1
    alunos.clear()
    alunos["nome"]=input(f"Digite o nome do aluno {x}: ")
    alunos["idade"]=int(input(f"Digite a idade do aluno {x}: "))
    alunos["nota"]=float(input(f"Digite a nota do aluno {x}: "))
    alunos["curso"]=input(f"Digite o curso do aluno {x}: ")
    print("")
    lista_alunos.append(alunos.copy())

for i in lista_alunos:
    print(f"Nome: {i['nome']}")

for alunos in lista_alunos:
    print(f"a maior nota é: {max(alunos['nota'])} do aluno {alunos['nome']}")

soma_notas = 0
for alunos in lista_alunos:
    soma_notas += alunos['nota']
print(f"A média das notas é: {soma_notas/qntd_alunos}")

for alunos in lista_alunos:
    if alunos['nota'] >= 7:
        print(f"O aluno {alunos['nome']} foi aprovado com a nota {alunos['nota']} que é maior ou igual a 7")




